<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.soldoutdigital.mommanager" android:host="auth-callback" />
                <data android:scheme="com.soldoutdigital.mommanager" android:host="payment-callback" />
                <data android:scheme="com.soldoutdigital.mommanager" android:host="payment-cancel" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ requires this to post any notification, including local ones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- @capacitor/local-notifications declares SCHEDULE_EXACT_ALARM in its own
         manifest (used only when a notification is scheduled with
         isExactNotification: true). We never schedule exact alarms — every
         reminder goes through src/lib/notifications.ts with
         isExactNotification: false + allowWhileIdle: true, since Google Play
         restricts this permission to apps whose core function requires exact
         timing, and a reminder arriving a few minutes late is an acceptable
         trade-off against that review risk. Removing it here overrides the
         plugin's manifest entry during the Gradle manifest merge so the
         installed app never declares it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
